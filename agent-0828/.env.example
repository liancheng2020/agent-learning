# Ports exposed on the host
FRONTEND_PORT=8080
API_PORT=8000

# PostgreSQL + pgvector
POSTGRES_DB=agent_review
POSTGRES_USER=agent
POSTGRES_PASSWORD=change-me-before-production
APP_DATABASE_BACKEND=postgres
VECTOR_STORE_BACKEND=postgres
DATABASE_URL=postgresql://agent:change-me-before-production@postgres:5432/agent_review

# Redis review cache
CACHE_BACKEND=redis
REDIS_URL=redis://redis:6379/0
REVIEW_CACHE_TTL_SECONDS=300

# Runtime observability
TRACE_PATH=/app/runtime/trace.jsonl
LOG_LEVEL=INFO
